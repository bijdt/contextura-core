{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.contextura.io/kit/2.json",
  "title": "Contextura Bouwdoos (kit): apps/<id>.yaml",
  "description": "A small app built from the Bouwdoos kit: what it shows and which actions it offers. kit/2 adds the sources notes and connection (with write for Home Assistant) and the actions note and share; the field kit stays 1. Not in this schema: which operation fits which domain (on-off for light, switch and input_boolean; activate for scene; start for script; open-close and position for cover; temperature for climate, with min and max between 10 and 25 in steps of 0.5; number for input_number; datetime for input_datetime), lock and alarm_control_panel never, and a timeline needs every except with notes or a connection.",
  "type": "object",
  "properties": {
    "kit": { "type": "number", "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "color": {
      "default": "indigo",
      "type": "string",
      "enum": ["amber", "teal", "green", "indigo", "blue", "rose", "fuchsia", "orange", "purple", "gray"]
    },
    "image": { "type": "string", "pattern": "^[a-z-]{1,30}$" },
    "source": {
      "default": { "kind": "own" },
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "type": "string", "const": "own" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "brain" },
            "path": { "type": "string", "pattern": "^[\\w-]+(\\/[\\w.-]+)*\\.ya?ml$" },
            "write": { "default": false, "type": "boolean" }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Notes with a type, a tag or in a folder; read only, the frontmatter only.",
          "properties": {
            "kind": { "type": "string", "const": "notes" },
            "type": { "type": "string", "pattern": "^[\\p{L}\\p{N}_-]{1,40}$" },
            "tag": { "type": "string", "pattern": "^[\\p{L}\\p{N}_-]{1,40}$" },
            "folder": { "type": "string", "pattern": "^[\\w-]+(\\/[\\w-]+)*$" }
          },
          "required": ["kind"],
          "anyOf": [
            { "required": ["type"] },
            { "required": ["tag"] },
            { "required": ["folder"] }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A connector the user already has. Read; with Home Assistant also control, only what is in write and was approved.",
          "properties": {
            "kind": { "type": "string", "const": "connection" },
            "service": { "type": "string", "enum": ["home-assistant", "calendar"] },
            "entities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" }
            },
            "search": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": { "type": "string", "minLength": 2, "maxLength": 60 }
            },
            "days": { "type": "integer", "minimum": 1, "maximum": 62 },
            "write": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "entity": { "type": "string", "maxLength": 50, "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "on-off",
                      "activate",
                      "start",
                      "open-close",
                      "position",
                      "temperature",
                      "number",
                      "datetime"
                    ]
                  },
                  "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "step": { "type": "number" }
                },
                "required": ["entity", "operation", "label"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "service"],
          "allOf": [
            {
              "if": {
                "properties": { "service": { "const": "home-assistant" } }
              },
              "then": {
                "anyOf": [
                  { "required": ["entities"] },
                  { "required": ["write"] }
                ],
                "not": { "anyOf": [{ "required": ["search"] }, { "required": ["days"] }] }
              }
            },
            {
              "if": {
                "properties": { "service": { "const": "calendar" } }
              },
              "then": {
                "required": ["search"],
                "not": { "anyOf": [{ "required": ["entities"] }, { "required": ["write"] }] }
              }
            }
          ],
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["list", "checklist", "counter", "meter", "timeline", "table", "chart"] },
        "fields": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" }
        },
        "date": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
        "every": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 3650 },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" }
          ]
        },
        "value": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "maxLength": 20 }
      },
      "required": ["kind", "fields"],
      "additionalProperties": false
    },
    "actions": {
      "default": [],
      "maxItems": 5,
      "type": "array",
      "items": { "type": "string", "enum": ["check", "add", "increment", "note", "share"] },
      "uniqueItems": true
    },
    "who": { "default": "owner", "type": "string", "const": "owner" }
  },
  "required": ["kit", "title", "view"],
  "additionalProperties": false
}
