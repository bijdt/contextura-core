{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.contextura.io/kit/1.json",
  "title": "Contextura Bouwdoos (kit): apps/<id>.yaml",
  "description": "A small app built from the Bouwdoos kit: what it shows and which actions it offers. Successor of bouwdoos/1.",
  "type": "object",
  "properties": {
    "kit": { "type": "number", "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "color": {
      "default": "indigo",
      "type": "string",
      "enum": ["amber", "teal", "green", "indigo", "blue", "rose", "fuchsia", "orange", "purple", "gray"]
    },
    "image": { "type": "string", "pattern": "^[a-z-]{1,30}$" },
    "source": {
      "default": { "kind": "own" },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "own" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "brain" },
            "path": { "type": "string", "pattern": "^[\\w-]+(\\/[\\w.-]+)*\\.ya?ml$" },
            "write": { "default": false, "type": "boolean" }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["list", "checklist", "counter", "meter", "timeline", "table", "chart"]
        },
        "fields": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" }
        },
        "date": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
        "every": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 3650 },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" }
          ]
        },
        "value": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "maxLength": 20 }
      },
      "required": ["kind", "fields"],
      "additionalProperties": false
    },
    "actions": {
      "default": [],
      "maxItems": 3,
      "type": "array",
      "items": { "type": "string", "enum": ["check", "add", "increment"] }
    },
    "who": { "default": "owner", "type": "string", "const": "owner" }
  },
  "required": ["kit", "title", "view"],
  "additionalProperties": false
}
