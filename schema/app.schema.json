{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.contextura.io/app/2.json",
  "title": "Contextura app manifest: app.json in the repo of a project",
  "description": "Per app the title, color, icon, the node command that delivers the tile, what it needs and whether it can be configured through the brain (apps/<id>.yaml). A product may add its own fields (e.g. a gallery); the reader (readManifest in app.ts) leaves them out. Successor of app/1 (Dutch names); the file keeps version 1.",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "runtime", "command"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "maxLength": 300 },
          "color": {
            "enum": ["amber", "teal", "green", "indigo", "blue", "rose", "fuchsia", "orange", "purple", "gray"]
          },
          "icon": {
            "enum": ["bolt", "house", "leaf", "chart", "document", "bike", "label", "star", "square"]
          },
          "runtime": { "const": "node" },
          "command": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "const": "node" }],
            "items": { "type": "string", "maxLength": 200 }
          },
          "page": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "const": "node" }],
            "items": { "type": "string", "maxLength": 200 }
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["connector", "env"],
              "properties": {
                "connector": { "type": "string", "maxLength": 60 },
                "env": {
                  "type": "object",
                  "required": ["url", "token"],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                      "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
                    },
                    "token": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                      "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
                    }
                  }
                }
              }
            }
          },
          "brain": {
            "type": "object",
            "required": ["files", "env"],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string", "pattern": "^[\\w-]+(/[\\w.-]+)*\\.(md|yaml|yml|json)$" }
              },
              "write": { "type": "boolean" },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
              }
            }
          },
          "config": {
            "type": "object",
            "required": ["path", "edit"],
            "properties": {
              "path": { "type": "string", "pattern": "^apps/[\\w-]+\\.ya?ml$" },
              "title": { "type": "string", "maxLength": 60 },
              "edit": { "const": "owner" }
            }
          }
        }
      }
    }
  }
}
