{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.contextura.io/app/3.json",
  "title": "Contextura app manifest: app.json in the repo of a project",
  "description": "Per app the title, color, icon, the node command that delivers the tile, what it needs, whether it can be configured through the brain (apps/<id>.yaml) and the gallery: how the app describes itself before it is installed (category, explanation, brainConfig, example, withoutModel, points, translations; readGallery in app.ts). A product may add its own fields; the readers leave them out. app/3 adds the gallery to app/2; the file keeps version 1.",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "runtime", "command"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "maxLength": 300 },
          "color": {
            "enum": ["amber", "teal", "green", "indigo", "blue", "rose", "fuchsia", "orange", "purple", "gray"]
          },
          "icon": {
            "enum": ["bolt", "house", "leaf", "chart", "document", "bike", "label", "star", "square"]
          },
          "runtime": { "const": "node" },
          "command": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "const": "node" }],
            "items": { "type": "string", "maxLength": 200 }
          },
          "page": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "const": "node" }],
            "items": { "type": "string", "maxLength": 200 }
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["connector", "env"],
              "properties": {
                "connector": { "type": "string", "maxLength": 60 },
                "env": {
                  "type": "object",
                  "required": ["url", "token"],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                      "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
                    },
                    "token": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                      "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
                    }
                  }
                }
              }
            }
          },
          "brain": {
            "type": "object",
            "required": ["files", "env"],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "type": "string", "pattern": "^[\\w-]+(/[\\w.-]+)*\\.(md|yaml|yml|json)$" }
              },
              "write": { "type": "boolean" },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,40}$",
                "not": { "enum": ["PATH", "HOME", "APP_DATA", "NODE_OPTIONS", "NODE_ENV", "LD_PRELOAD"] }
              }
            }
          },
          "config": {
            "type": "object",
            "required": ["path", "edit"],
            "properties": {
              "path": { "type": "string", "pattern": "^apps/[\\w-]+\\.ya?ml$" },
              "title": { "type": "string", "maxLength": 60 },
              "edit": { "const": "owner" }
            }
          },
          "category": {
            "description": "Where the app stands in the gallery",
            "enum": ["home", "garden", "family", "money", "health", "work", "brain"]
          },
          "explanation": { "type": "string", "maxLength": 600, "description": "What the app does in a few sentences (description is the one-liner)" },
          "brainConfig": {
            "type": "array",
            "maxItems": 8,
            "description": "What the app needs in the brain, so that an application can show what is already there and what is missing",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "path", "explanation"],
                  "properties": {
                    "kind": { "const": "file" },
                    "path": { "type": "string", "pattern": "^[\\w-]+(/[\\w.-]+)*$" },
                    "explanation": { "type": "string", "minLength": 1, "maxLength": 200 }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "folder", "explanation"],
                  "properties": {
                    "kind": { "const": "notes" },
                    "folder": { "type": "string", "pattern": "^[\\w-]+(/[\\w.-]+)*$" },
                    "field": { "type": "string", "pattern": "^[\\w-]{1,40}$" },
                    "minimum": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
                    "explanation": { "type": "string", "minLength": 1, "maxLength": 200 }
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "explanation"],
                  "properties": {
                    "kind": { "const": "text" },
                    "explanation": { "type": "string", "minLength": 1, "maxLength": 200 }
                  }
                }
              ]
            }
          },
          "example": { "$ref": "https://schema.contextura.io/tile/2.json", "description": "A tile with made-up data, shown before installing" },
          "withoutModel": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 30 },
            "description": "What the app can do without a language model"
          },
          "points": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "description": "What the app adds to the brain and the chat: 1 by itself at the right moment, 2 live data or actions through a connector, 3 fixed rules as code, 4 quick capture without the chat, 5 showing what text cannot"
          },
          "translations": {
            "type": "object",
            "description": "Per language (two letters) the title, description and explanation; a missing field falls back to the ordinary one",
            "propertyNames": { "pattern": "^[a-z]{2}$" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 40 },
                "description": { "type": "string", "maxLength": 300 },
                "explanation": { "type": "string", "maxLength": 600 }
              }
            }
          }
        }
      }
    }
  }
}
