{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.contextura.io/twin/3.json",
  "title": "Feed your twin",
  "description": "Settings, the owner's fixed test questions and the log of asked questions to complete the twin. Never the answers themselves: those go through the inbox to notes. Checked by the lint (checkTwin).",
  "type": "object",
  "required": ["version", "settings", "test", "log"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "settings": {
      "type": "object",
      "required": ["dailyLimit", "closed"],
      "additionalProperties": false,
      "properties": {
        "dailyLimit": { "type": "integer", "minimum": 1, "maximum": 100, "description": "At most this many questions per day" },
        "closed": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "description": "Domains (hubs) the twin asks nothing about" }
      }
    },
    "test": {
      "type": "array",
      "description": "The twenty-questions test: questions whose answer the owner knows (form guess)",
      "items": {
        "type": "object",
        "required": ["id", "question", "layer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["thinking", "knowing", "judging", "rhythm"] },
          "domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "log": {
      "type": "array",
      "description": "One entry per asked question, newest at the bottom",
      "items": {
        "type": "object",
        "required": ["id", "date", "form", "layer", "question", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "form": { "enum": ["this-or-that", "true-false", "opinion", "guess", "gap", "like", "tell", "upload", "resolve"] },
          "layer": { "enum": ["thinking", "knowing", "judging", "rhythm"] },
          "domain": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "source": { "type": "string", "description": "The note the question came from, twin.json#<test-id>, pool#<key> or tag#<tag>" },
          "question": { "type": "string", "minLength": 1 },
          "status": { "enum": ["answered", "skipped"] },
          "landing": { "type": "string", "description": "The inbox file with the answer (required when answered, except with like)" },
          "score": { "enum": [0, 1, 2], "description": "Only with form guess: how well the twin knew it" },
          "reason": { "enum": ["known", "irrelevant", "personal"], "description": "Only with a skipped question: why" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "description": "The milestones the user has seen (names, each once)",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "record": {
      "type": "object",
      "description": "The best result of a challenge",
      "required": ["points", "date"],
      "additionalProperties": false,
      "properties": {
        "points": { "type": "number", "minimum": 0 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
